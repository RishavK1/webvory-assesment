# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value below has a working default in
# app/core/config.py, so the app runs without a .env file at all.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=Webvory
DEBUG=false

# --- Database ---
# SQLite (default) — zero setup, the file is created on first migration.
DATABASE_URL=sqlite:///./webvory.db
# PostgreSQL — uncomment and adjust to use Postgres instead. No code changes.
# DATABASE_URL=postgresql+psycopg://webvory:webvory@localhost:5432/webvory

# --- Authentication ---
# CHANGE THIS IN PRODUCTION. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- External API integration ---
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
# The demo provider needs no credentials. Set a key here and it is sent as
# `Authorization: Bearer <key>` on every outbound request.
# EXTERNAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=8.0
EXTERNAL_API_MAX_RETRIES=3
EXTERNAL_API_BACKOFF_SECONDS=0.5
EXTERNAL_API_CACHE_TTL_SECONDS=300
EXTERNAL_API_RATE_LIMIT_PER_MINUTE=30

# --- Pagination ---
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
